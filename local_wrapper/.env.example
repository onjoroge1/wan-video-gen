# Copy to .env next to api_server.py, fill in, chmod 600.
# The server reads these at startup (inject via:  set -a; source .env; set +a)

# --- Runpod (required) ---
RUNPOD_API_KEY=rpa_your_key_here            # runpod.io -> Settings -> API Keys
RUNPOD_VOLUME_ID=your_volume_id             # runpod.io -> Storage -> your network volume
RUNPOD_POD_NAME=wan22-video-gen             # name PREFIX; all matching pods form the worker pool

# --- Pod spec overrides (optional; defaults shown) ---
# RUNPOD_GPU=NVIDIA GeForce RTX 5090
# RUNPOD_DC=EU-RO-1
# RUNPOD_IMAGE=hearmeman/comfyui-wan-template:v26

# --- API server (optional) ---
# WAN_API_PORT=8787
# WAN_MAX_UPLOAD_MB=25        # decoded input image and request body ceiling
# WAN_MAX_PROMPT_CHARS=4000   # reject accidental or abusive oversized prompts
# WAN_IDLE_STOP_MIN=10          # stop pods after N idle minutes
# WAN_JOB_RETRIES=3             # infra-failure requeues per job
# WAN_MAX_PODS=3                # autoscaler ceiling
# WAN_SCALE_THRESHOLD=6         # queue depth that triggers scale-out
# WAN_WATCHDOG_MIN=30           # no-completions kill-switch (fails toward $0/hr)

# --- Durable job metadata (optional; JSON fallback when unset) ---
# DATABASE_URL=postgresql://user:password@host:5432/wan?sslmode=require

# --- Generated video storage (optional; local files when unset) ---
# WAN_STORAGE_BACKEND=s3
# WAN_S3_BUCKET=wan-videos
# WAN_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
# WAN_S3_REGION=auto
# WAN_S3_ACCESS_KEY_ID=your_s3_access_key
# WAN_S3_SECRET_ACCESS_KEY=your_s3_secret_key
# WAN_S3_PREFIX=videos
# WAN_SIGNED_URL_SECONDS=3600    # private result link lifetime; maximum 604800
# WAN_DELETE_LOCAL_AFTER_UPLOAD=true

# --- Remote access (optional; localhost-only without these) ---
# WAN_BIND=0.0.0.0              # refuses to bind beyond localhost without a token
# WAN_API_TOKEN=generate_with__openssl_rand_-hex_24
